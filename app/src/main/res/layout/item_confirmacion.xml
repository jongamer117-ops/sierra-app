<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_field"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/detalleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/sierra_text_primary"
        android:textSize="16sp"
        tools:text="Borrar 30 archivos temporales en /home/pi/tmp" />

    <TextView
        android:id="@+id/expiraTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp"
        tools:text="Expira en 1:47" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rechazarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/sierra_error"
            android:text="@string/btn_rechazar" />

        <Button
            android:id="@+id/aprobarButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/sierra_accent"
            android:text="@string/btn_aprobar" />

    </LinearLayout>

</LinearLayout>
