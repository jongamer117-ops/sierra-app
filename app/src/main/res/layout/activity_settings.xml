<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_room_glow"
    android:fillViewport="true"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/settings_title"
            android:textColor="@color/sierra_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Conexión con el núcleo de Sierra"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_ip_label"
            android:textColor="@color/sierra_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/ipEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_field"
            android:hint="100.86.158.55"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_port_label"
            android:textColor="@color/sierra_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/portEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_field"
            android:hint="8000"
            android:inputType="number"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_dim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_token_label"
            android:textColor="@color/sierra_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/tokenEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_field"
            android:hint="opcional por ahora"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_dim" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_save"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
