<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <!-- Fijo arriba, fuera del ScrollView: siempre alcanzable aunque el
         contenido de abajo sea mas largo que la pantalla o el teclado
         este abierto (antes el boton de abajo quedaba inalcanzable). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/sierra_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/saveButtonTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_save" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_ip_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/ipEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="100.71.115.36"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_port_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/portEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="8200"
        android:inputType="number"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_token_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/tokenEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_field"
        android:hint="obligatorio"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/vigilanciaSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:checked="true"
        android:text="@string/settings_vigilancia_label"
        android:textColor="@color/sierra_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@color/sierra_surface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_chat_title"
        android:textColor="@color/sierra_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/usarCortanaSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/settings_usar_cortana_label"
        android:textColor="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_chat_ip_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/chatIpEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="100.86.158.55"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_chat_port_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/chatPortEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="8300"
        android:inputType="number"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_chat_token_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/chatTokenEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_field"
        android:hint="opcional — sin esto el chat no funciona"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@color/sierra_surface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_vnc_title"
        android:textColor="@color/sierra_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_vnc_ip_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/vncIpEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="100.86.158.55"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_vnc_port_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/vncPortEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_field"
        android:hint="5900"
        android:inputType="number"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_save" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:background="@color/sierra_surface" />

    <Button
        android:id="@+id/actualizarButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_update_button" />

    <TextView
        android:id="@+id/updateStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="11sp" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>
