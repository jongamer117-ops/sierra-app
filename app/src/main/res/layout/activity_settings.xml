<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".SettingsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/settings_title"
        android:textColor="@color/sierra_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_ip_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/ipEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="100.71.115.36"
        android:inputType="text"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_port_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/portEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_field"
        android:hint="8200"
        android:inputType="number"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_token_label"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/tokenEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_field"
        android:hint="obligatorio"
        android:inputType="textPassword"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_save" />

</LinearLayout>
