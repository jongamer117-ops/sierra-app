<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/sierra_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp">

                <ImageButton
                    android:id="@+id/confirmacionesButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_ver_confirmaciones"
                    android:src="@drawable/ic_confirmaciones"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/confirmacionesBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/sierra_text_primary"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="1"
                    tools:visibility="visible" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                android:padding="8dp" />
        </LinearLayout>

        <!-- ESTADO (protagonista): anillo + una linea de Sierra, no un manual
             de uso. Reemplaza al subtitulo que explicaba la app. -->
        <LinearLayout
            android:id="@+id/estadoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/estadoAnillo"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_estado_anillo" />

            <TextView
                android:id="@+id/estadoTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/presencia_quieta"
                android:textColor="@color/sierra_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/backendChipButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:textColor="@color/sierra_text_primary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/respuestaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:minHeight="110dp"
            android:padding="18dp"
            android:text="@string/hint_respuesta"
            android:textColor="@color/sierra_text_primary"
            android:textSize="17sp"
            android:lineSpacingExtra="3dp" />

        <!-- TRANSCRIPCIÓN + ENVIAR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hint_transcripcion"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/transcripcionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/hint_transcripcion"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                android:indeterminateTint="@color/sierra_accent" />

            <Button
                android:id="@+id/enviarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_enviar"
                android:backgroundTint="@color/sierra_primary"
                android:textColor="@color/sierra_text_primary" />
        </LinearLayout>

        <!-- TTS -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/leerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="@string/switch_leer_respuesta"
            android:textColor="@color/sierra_text_secondary" />

        <!-- MICRÓFONO -->
        <ImageButton
            android:id="@+id/hablarButton"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/btn_hablar"
            android:elevation="8dp"
            android:src="@drawable/ic_mic"
            android:scaleType="center" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/sierra_surface_border" />

        <!-- GENERAR IMAGEN: colapsado por defecto. Cada control a la vista
             grita "menu"; la presencia vive arriba, esto vive atras. -->
        <LinearLayout
            android:id="@+id/imagenHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/imagenHeaderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_generar_imagen"
                android:textColor="@color/sierra_accent"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/imagenChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸"
                android:textColor="@color/sierra_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/imagenContenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/hint_generar_imagen_nota"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/imagenPromptEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/hint_generar_imagen"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_resolucion"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/resolucionSpinner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_steps"
                    android:textColor="@color/sierra_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/stepsEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field"
                    android:hint="8"
                    android:inputType="number"
                    android:padding="14dp"
                    android:textColor="@color/sierra_text_primary"
                    android:textColorHint="@color/sierra_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cfg"
                    android:textColor="@color/sierra_text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/cfgEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_field"
                    android:hint="1"
                    android:inputType="numberDecimal"
                    android:padding="14dp"
                    android:textColor="@color/sierra_text_primary"
                    android:textColorHint="@color/sierra_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_sampler"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/samplerSpinner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_scheduler"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/schedulerSpinner"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/generarImagenButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip"
            android:text="@string/btn_generar_imagen"
            android:textColor="@color/sierra_text_primary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
