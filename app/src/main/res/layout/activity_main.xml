<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/sierra_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <ImageButton
        android:id="@+id/accionesButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_ver_acciones"
        android:src="@drawable/ic_acciones"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toStartOf="@id/confirmacionesButton" />

    <ImageButton
        android:id="@+id/confirmacionesButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_ver_confirmaciones"
        android:src="@drawable/ic_confirmaciones"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toStartOf="@id/settingsButton" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_title"
        android:src="@drawable/ic_settings"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintBottom_toBottomOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/chat_subtitle"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/transcripcionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hint_transcripcion"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/transcripcionEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"
        android:gravity="top|start"
        android:hint="@string/hint_transcripcion"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:maxLines="4"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_secondary"
        app:layout_constraintTop_toBottomOf="@id/transcripcionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/enviarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/btn_enviar"
        app:layout_constraintTop_toBottomOf="@id/transcripcionEditText"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/enviarButton"
        app:layout_constraintBottom_toBottomOf="@id/enviarButton"
        app:layout_constraintEnd_toStartOf="@id/enviarButton"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/respuestaLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_respuesta"
        android:textColor="@color/sierra_text_secondary"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/enviarButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/respuestaScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/respuestaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/leerSwitch">

        <TextView
            android:id="@+id/respuestaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_respuesta"
            android:textColor="@color/sierra_text_primary"
            android:textSize="16sp" />
    </ScrollView>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/leerSwitch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:checked="true"
        android:text="@string/switch_leer_respuesta"
        android:textColor="@color/sierra_text_secondary"
        app:layout_constraintBottom_toTopOf="@id/hablarButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/hablarButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_mic_button"
        android:contentDescription="@string/btn_hablar"
        android:elevation="6dp"
        android:src="@drawable/ic_mic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
