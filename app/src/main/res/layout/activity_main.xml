<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/sierra_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp">

                <ImageButton
                    android:id="@+id/confirmacionesButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_ver_confirmaciones"
                    android:src="@drawable/ic_confirmaciones"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/confirmacionesBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/sierra_text_primary"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="1"
                    tools:visibility="visible" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                android:padding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/estadoRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/estadoAnillo"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_estado_anillo" />

            <TextView
                android:id="@+id/estadoTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/presencia_quieta"
                android:textColor="@color/sierra_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/respuestaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:minHeight="110dp"
            android:padding="18dp"
            android:text="@string/hint_respuesta"
            android:textColor="@color/sierra_text_primary"
            android:textSize="17sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/transcripcionEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/hint_transcripcion"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="1"
                android:maxLines="3"
                android:padding="14dp"
                android:textColor="@color/sierra_text_primary"
                android:textColorHint="@color/sierra_text_secondary" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:indeterminateTint="@color/sierra_accent" />

            <Button
                android:id="@+id/enviarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btn_enviar"
                android:backgroundTint="@color/sierra_primary"
                android:textColor="@color/sierra_text_primary" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/leerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="@string/switch_leer_respuesta"
            android:textColor="@color/sierra_text_secondary" />

        <ImageButton
            android:id="@+id/hablarButton"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/btn_hablar"
            android:elevation="8dp"
            android:src="@drawable/ic_mic"
            android:scaleType="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sierra_surface_border" />

        <LinearLayout
            android:id="@+id/accionesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/accionesHeaderText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acciones_manuales_header"
                android:textColor="@color/sierra_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/accionesChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▸"
                android:textColor="@color/sierra_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accionesManualesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/verHoraButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:text="@string/btn_ver_hora"
                        android:textColor="@color/sierra_text_primary"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <Button
                        android:id="@+id/abrirFirefoxButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:text="@string/btn_abrir_firefox"
                        android:textColor="@color/sierra_text_primary"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/busquedaEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_buscar_youtube"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/sierra_text_primary"
                android:textColorHint="@color/sierra_text_secondary" />

            <Button
                android:id="@+id/buscarYoutubeButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_chip"
                android:text="@string/btn_buscar_youtube"
                android:textColor="@color/sierra_text_primary" />

            <EditText
                android:id="@+id/archivoEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_field"
                android:hint="@string/hint_ver_archivo"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/sierra_text_primary"
                android:textColorHint="@color/sierra_text_secondary" />

            <Button
                android:id="@+id/verArchivoButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:text="@string/btn_ver_archivo"
                android:textColor="@color/sierra_text_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
