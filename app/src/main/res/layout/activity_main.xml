<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Header: identidad + presencia -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/sierra_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workspace_title"
                android:textColor="@color/sierra_text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/status_online"
            android:textColor="@color/sierra_success"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_field"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings"
            app:tint="@color/sierra_text_secondary" />
    </LinearLayout>

    <!-- Consola de entrada (espacio de trabajo inferior-izq conceptual) -->
    <TextView
        android:id="@+id/transcripcionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_console"
        android:textColor="@color/sierra_text_dim"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/transcripcionEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field"
        android:gravity="top|start"
        android:hint="@string/hint_transcripcion"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:maxLines="3"
        android:padding="14dp"
        android:textColor="@color/sierra_text_primary"
        android:textColorHint="@color/sierra_text_dim"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/transcripcionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/enviarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_enviar"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/transcripcionEditText"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/sierra_primary"
        app:layout_constraintTop_toTopOf="@id/enviarButton"
        app:layout_constraintBottom_toBottomOf="@id/enviarButton"
        app:layout_constraintEnd_toStartOf="@id/enviarButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Pantalla holográfica central (el "cuarto" / display principal) -->
    <TextView
        android:id="@+id/respuestaLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_respuesta"
        android:textColor="@color/sierra_text_dim"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toBottomOf="@id/enviarButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/hologramFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_panel"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/respuestaLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/leerSwitch">

        <ScrollView
            android:id="@+id/respuestaScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/respuestaTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_respuesta"
                android:textColor="@color/sierra_text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </FrameLayout>

    <!-- Controles inferiores: switch + nodo de activación (mic) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/leerSwitch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:checked="true"
        android:text="@string/switch_leer_respuesta"
        android:textColor="@color/sierra_text_secondary"
        app:layout_constraintBottom_toTopOf="@id/hablarButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/hablarButton"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_mic_button"
        android:contentDescription="@string/btn_hablar"
        android:elevation="12dp"
        android:src="@drawable/ic_mic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
