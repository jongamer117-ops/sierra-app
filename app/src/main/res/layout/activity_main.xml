<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/sierra_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <ImageButton
                android:id="@+id/confirmacionesButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_ver_confirmaciones"
                android:src="@drawable/ic_confirmaciones"
                android:padding="8dp" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                android:padding="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/chat_subtitle"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/backendChipButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:textColor="@color/sierra_text_primary"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="14dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <!-- RESPUESTA (protagonista) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/label_respuesta"
            android:textColor="@color/sierra_accent"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/respuestaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:minHeight="110dp"
            android:padding="18dp"
            android:text="@string/hint_respuesta"
            android:textColor="@color/sierra_text_primary"
            android:textSize="17sp"
            android:lineSpacingExtra="3dp" />

        <!-- TRANSCRIPCIÓN + ENVIAR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hint_transcripcion"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/transcripcionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/hint_transcripcion"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                android:indeterminateTint="@color/sierra_accent" />

            <Button
                android:id="@+id/enviarButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_enviar"
                android:backgroundTint="@color/sierra_primary"
                android:textColor="@color/sierra_text_primary" />
        </LinearLayout>

        <!-- TTS -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/leerSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="true"
            android:text="@string/switch_leer_respuesta"
            android:textColor="@color/sierra_text_secondary" />

        <!-- MICRÓFONO -->
        <ImageButton
            android:id="@+id/hablarButton"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/btn_hablar"
            android:elevation="8dp"
            android:src="@drawable/ic_mic"
            android:scaleType="center" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/sierra_surface_border" />

        <!-- GENERAR IMAGEN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/label_generar_imagen"
            android:textColor="@color/sierra_accent"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/hint_generar_imagen_nota"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/imagenPromptEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="@string/hint_generar_imagen"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <Button
            android:id="@+id/generarImagenButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:text="@string/btn_generar_imagen"
            android:textColor="@color/sierra_text_primary" />

    </LinearLayout>
</ScrollView>
