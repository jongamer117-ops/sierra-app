<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sierra_bg"
    android:fillViewport="true"
    tools:context=".AccionesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/acciones_title"
            android:textColor="@color/sierra_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/acciones_subtitle"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/hablarButton"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/btn_hablar"
            android:elevation="6dp"
            android:src="@drawable/ic_mic" />

        <TextView
            android:id="@+id/transcripcionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/resultadoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textColor="@color/sierra_text_primary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="@color/sierra_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/acciones_manual_title"
            android:textColor="@color/sierra_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/verHoraButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_ver_hora" />

            <Button
                android:id="@+id/abrirFirefoxButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_abrir_firefox" />
        </LinearLayout>

        <EditText
            android:id="@+id/busquedaEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_field"
            android:hint="@string/hint_buscar_youtube"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <Button
            android:id="@+id/buscarYoutubeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_buscar_youtube" />

        <EditText
            android:id="@+id/archivoEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_field"
            android:hint="@string/hint_ver_archivo"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/sierra_text_primary"
            android:textColorHint="@color/sierra_text_secondary" />

        <Button
            android:id="@+id/verArchivoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ver_archivo" />

    </LinearLayout>
</ScrollView>
