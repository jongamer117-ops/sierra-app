<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/sierra_listening" />
            <stroke
                android:width="3dp"
                android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sierra_primary" />
            <stroke
                android:width="2dp"
                android:color="@color/sierra_accent" />
        </shape>
    </item>
</selector>
